#!/bin/sh
#
# PwnGuard pre-commit hook (PWNGUARD_HOOK_V2)
# AI-powered security review for staged changes.
# Installed automatically via composer install.
#
# Backends (auto-detected):
#   1. Claude Code (if installed, uses Pro subscription)
#   2. Ollama (if running locally)
#
# Override:              pwnguard/hooks/pre-commit --backend ollama
# Skip one commit only:  PWNGUARD_SKIP=1 git commit ...
# Skip all hooks:        git commit --no-verify
#

# Find project root
PROJECT_ROOT="$(git rev-parse --show-toplevel 2>/dev/null)"
if [ -z "$PROJECT_ROOT" ]; then
    echo "Error: not inside a git repository"
    exit 1
fi

# Per-shell escape hatch, separate from --no-verify (which skips ALL hooks).
# Useful when iterating on WIP commits without disabling unrelated hooks.
if [ "${PWNGUARD_SKIP:-0}" = "1" ]; then
    exit 0
fi

# Resolve the audit script location for both supported layouts:
#   1. Embedded install: <project>/pwnguard/audit.py
#   2. Standalone install (PwnGuard's own repository): <project>/audit.py
if [ -f "$PROJECT_ROOT/pwnguard/audit.py" ]; then
    AUDIT_SCRIPT="$PROJECT_ROOT/pwnguard/audit.py"
elif [ -f "$PROJECT_ROOT/audit.py" ]; then
    AUDIT_SCRIPT="$PROJECT_ROOT/audit.py"
else
    echo "Warning: audit.py not found, skipping security check"
    exit 0
fi

# Check Python is available. PwnGuard needs Python 3.7+ (dataclasses,
# f-strings). Python 2 is EOL since 2020 and intentionally not supported.
if command -v python3 >/dev/null 2>&1; then
    PYTHON=python3
elif command -v python >/dev/null 2>&1; then
    PYTHON=python
else
    echo "Warning: Python not found, skipping PwnGuard"
    exit 0
fi

# Verify it's actually Python 3.7+. If only Python 2 is installed under
# `python`, bail gracefully instead of crashing the commit with a syntax error.
if ! $PYTHON -c 'import sys; sys.exit(0 if sys.version_info >= (3, 7) else 1)' 2>/dev/null; then
    PY_VER=$($PYTHON -c 'import sys; print("%d.%d" % sys.version_info[:2])' 2>/dev/null)
    echo "PwnGuard requires Python 3.7+ (found ${PY_VER:-unknown}). Skipping."
    exit 0
fi

# Check pyyaml is installed. Do NOT auto-install: --break-system-packages
# silently mutates the user's system Python and can corrupt PEP 668-managed
# environments (Debian/Ubuntu). Warn and skip instead so a missing dev dep
# never blocks a commit.
if ! $PYTHON -c "import yaml" 2>/dev/null; then
    echo "PwnGuard: missing dependency 'pyyaml'. Install one of:"
    echo "  pip install --user pyyaml"
    echo "  pipx install pyyaml"
    echo "  apt install python3-yaml      (or your distro equivalent)"
    echo "Skipping security audit for this commit."
    exit 0
fi

# Self-test: when committing changes to PwnGuard itself (standalone
# layout: audit.py at repo root AND tests/ present), run the bundled
# pytest suite before the security scan. Failures here mean the
# auditor's own invariants regressed - block the commit, since a
# broken auditor produces unreliable findings.
#
# This branch deliberately does NOT fire for consumer repos: their
# audit.py lives under pwnguard/, not at root, so the first check
# ($PROJECT_ROOT/audit.py exists AND tests/ exists) is false.
if [ -f "$PROJECT_ROOT/audit.py" ] && [ -f "$PROJECT_ROOT/tests/test_anchors.py" ]; then
    if $PYTHON -c "import pytest" 2>/dev/null; then
        echo "PwnGuard: running internal test suite..."
        $PYTHON -m pytest "$PROJECT_ROOT/tests/" --quiet
        TEST_EXIT=$?
        if [ $TEST_EXIT -ne 0 ]; then
            echo ""
            echo "Commit blocked: PwnGuard internal tests failed (exit $TEST_EXIT)."
            echo "Fix the failures above before committing, or skip with: git commit --no-verify"
            echo ""
            exit 1
        fi
    else
        echo "PwnGuard: pytest not installed; skipping internal test suite."
        echo "  pip install --user -r requirements-dev.txt"
    fi
fi

# Run the audit
$PYTHON "$AUDIT_SCRIPT" --mode hook "$@"
EXIT_CODE=$?

if [ $EXIT_CODE -eq 1 ]; then
    echo ""
    echo "Commit blocked by PwnGuard."
    echo "Fix the findings above, or skip with: git commit --no-verify"
    echo ""
fi

exit $EXIT_CODE
