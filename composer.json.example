{
    "_README": "Merge these scripts into your existing composer.json",
    "_README2": "If you already have post-install-cmd, add setup-pwnguard to the existing array",

    "scripts": {
        "setup-pwnguard": "python3 pwnguard/install-hook.py || python pwnguard/install-hook.py || echo '[pwnguard] Python not found, skipping hook install'",
        "post-install-cmd": [
            "@setup-pwnguard"
        ],
        "post-update-cmd": [
            "@setup-pwnguard"
        ]
    }
}
