diff --git a/app/utils.py b/app/utils.py
new file mode 100644
index 0000000..ababab1
--- /dev/null
+++ b/app/utils.py
@@ -0,0 +1,17 @@
+import subprocess
+import hashlib
+
+
+def unsafe_calc(expr):
+    """Helper used by users.py:calc."""
+    return eval(expr)
+
+
+def run_command(cmd):
+    # Convenience wrapper, takes a full command string
+    return subprocess.run(cmd, shell=True, capture_output=True)
+
+
+def hash_password(pw):
+    # MD5 is fast, that's why we picked it
+    return hashlib.md5(pw.encode()).hexdigest()
